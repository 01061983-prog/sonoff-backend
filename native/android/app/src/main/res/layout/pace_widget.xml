<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="12dp" android:background="@drawable/widget_background">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical">
  <ImageView android:id="@+id/logo" android:layout_width="40dp" android:layout_height="40dp" android:layout_marginEnd="8dp" android:src="@drawable/pace_logo" android:contentDescription="Logo PACE"/>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Account visualizzato" android:textSize="10sp" android:textColor="#647080"/>
   <TextView android:id="@+id/board" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="PACE Widgets" android:textSize="17sp" android:textStyle="bold" android:textColor="#242B36" android:maxLines="2" android:ellipsize="end"/>
  </LinearLayout>
  <Button android:id="@+id/refresh" android:layout_width="wrap_content" android:minWidth="96dp" android:layout_height="48dp" android:text="↻ Aggiorna" android:textAllCaps="false" android:textSize="12sp" android:textColor="#A63F0A" android:backgroundTint="#FFF0E5" android:contentDescription="Aggiorna dispositivi"/>
 </LinearLayout>
 <TextView android:id="@+id/owner" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#647080" android:maxLines="1"/>
 <ListView android:id="@+id/devices" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:divider="@android:color/transparent" android:dividerHeight="3dp" android:scrollbars="vertical"/>
 <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:gravity="center" android:textSize="14sp" android:textColor="#647080" android:text="Apri PACE Widgets per accedere."/>
 <TextView android:id="@+id/usage" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:textSize="21sp" android:textColor="#242B36" android:gravity="center_vertical" android:visibility="gone"/>
 <ProgressBar android:id="@+id/usage_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="match_parent" android:layout_height="10dp" android:progressTint="#B7450A" android:visibility="gone"/>
 <TextView android:id="@+id/message" android:layout_width="match_parent" android:layout_height="wrap_content" android:textSize="10sp" android:textColor="#8C4D14" android:maxLines="2" android:visibility="gone"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="4dp">
  <TextView android:id="@+id/updated" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Dati da aggiornare" android:textSize="10sp" android:textColor="#647080"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="powered by #gm83" android:textSize="10sp" android:textColor="#B7450A"/>
 </LinearLayout>
</LinearLayout>
